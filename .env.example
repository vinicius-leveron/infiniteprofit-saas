VITE_SUPABASE_PROJECT_ID=nztnctrkmfrgclrnflfa
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://nztnctrkmfrgclrnflfa.supabase.co
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_PUBLIC_SIGNUP=false
VITE_ENABLE_HOTMART_CHECKOUT=true
VITE_HOTMART_CANARY_WORKSPACE_IDS=
VITE_APP_PUBLIC_URL=https://infiniteprofit-saas.onrender.com
VITE_SUPPORT_EMAIL=suporte@infiniteprofit.com.br
VITE_STATUS_URL=
VITE_LEGAL_ENTITY_NAME=Infinite Profit
VITE_APP_ENVIRONMENT=development
VITE_APP_RELEASE=local

# Edge Functions (configure with `supabase secrets set`, never expose as VITE_*)
APP_PUBLIC_URL=https://infiniteprofit-saas.onrender.com
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=Infinite Profit <acesso@auth.infiniteprofit.com.br>

# Optional QA/E2E variables
PLAYWRIGHT_BASE_URL=https://infiniteprofit-saas.onrender.com
E2E_EMAIL=qa-admin@example.com
E2E_PASSWORD=replace_with_test_password
E2E_PROJECT_ID=c4f027b4-f867-4d7f-a522-dfb272c33104
E2E_PUBLIC_SHARE_TOKEN=replace_with_public_share_token
E2E_AUTOMATION_KEY=replace_with_automation_key_for_edge_positive_tests

# Optional production SLO canary
PROBE_APP_URL=https://infiniteprofit-saas.onrender.com
PROBE_AUTH_EMAIL=qa-admin@example.com
PROBE_AUTH_PASSWORD=replace_with_test_password
PROBE_SAMPLES=3
PROBE_TIMEOUT_MS=8000

# Durable checkout webhook queue (AWS SQS)
GATEWAY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account-id/queue-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_least_privilege_access_key
AWS_SECRET_ACCESS_KEY=replace_with_least_privilege_secret_key
AUTOMATION_KEY=replace_with_internal_automation_key
GATEWAY_QUEUE_BATCH_SIZE=5
GATEWAY_QUEUE_WAIT_TIME_SECONDS=20
GATEWAY_QUEUE_DELIVERY_TIMEOUT_MS=25000
GATEWAY_QUEUE_HEARTBEAT_INTERVAL_MS=60000

# Hotmart API. Each client's Client ID, Client Secret and Basic token are
# received once by hotmart-auth and stored in Vault; never configure them as
# VITE_* or shared environment variables.
HOTMART_OAUTH_TOKEN_URL=https://api-sec-vlc.hotmart.com/security/oauth/token

# Creative processing worker
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
CREATIVE_TRANSCRIPTION_PROVIDER=openai
CREATIVE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
CREATIVE_ANALYSIS_PROVIDER=lovable
CREATIVE_ANALYSIS_MODEL=google/gemini-3-flash-preview
CREATIVE_ANALYSIS_PROMPT_VERSION=creative-analysis-v5
OPENAI_API_KEY=replace_with_openai_api_key
OPENROUTER_API_KEY=replace_with_openrouter_api_key
LOVABLE_API_KEY=replace_with_lovable_api_key
CREATIVE_WORKER_POLL_INTERVAL_MS=5000
CREATIVE_WORKER_BATCH_SIZE=2
