FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID
ARG VITE_ENABLE_GOOGLE_AUTH
ARG VITE_ENABLE_PUBLIC_SIGNUP
ARG VITE_DISABLE_HOTMART_CHECKOUT
ARG VITE_HOTMART_CANARY_WORKSPACE_IDS
ARG VITE_APP_PUBLIC_URL
ARG VITE_SUPPORT_EMAIL
ARG VITE_STATUS_URL
ARG VITE_LEGAL_ENTITY_NAME
ARG VITE_APP_ENVIRONMENT
ARG RAILWAY_GIT_COMMIT_SHA

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_SUPABASE_PROJECT_ID=$VITE_SUPABASE_PROJECT_ID \
    VITE_ENABLE_GOOGLE_AUTH=$VITE_ENABLE_GOOGLE_AUTH \
    VITE_ENABLE_PUBLIC_SIGNUP=$VITE_ENABLE_PUBLIC_SIGNUP \
    VITE_DISABLE_HOTMART_CHECKOUT=$VITE_DISABLE_HOTMART_CHECKOUT \
    VITE_HOTMART_CANARY_WORKSPACE_IDS=$VITE_HOTMART_CANARY_WORKSPACE_IDS \
    VITE_APP_PUBLIC_URL=$VITE_APP_PUBLIC_URL \
    VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_STATUS_URL=$VITE_STATUS_URL \
    VITE_LEGAL_ENTITY_NAME=$VITE_LEGAL_ENTITY_NAME \
    VITE_APP_ENVIRONMENT=$VITE_APP_ENVIRONMENT \
    VITE_APP_RELEASE=$RAILWAY_GIT_COMMIT_SHA

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:2.10-alpine

COPY infra/railway/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
