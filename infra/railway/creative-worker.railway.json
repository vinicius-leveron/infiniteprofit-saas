{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/creative-processor/Dockerfile",
    "watchPatterns": [
      "/package.json",
      "/package-lock.json",
      "/workers/creative-processor/**",
      "/infra/railway/creative-worker.railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": "0",
    "drainingSeconds": "120"
  }
}
