{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/gateway-queue-consumer/Dockerfile",
    "watchPatterns": [
      "/package.json",
      "/package-lock.json",
      "/workers/gateway-queue-consumer/**",
      "/infra/railway/gateway-consumer.railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": "0",
    "drainingSeconds": "60"
  }
}
